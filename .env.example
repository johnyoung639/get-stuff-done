# Copy to .env and fill in. Never commit .env.

# First-run parent PIN (change it later in Parents > Settings; after first run this value is ignored)
PARENT_PIN=1234

# Your child's name or nickname for greetings (can also be set in Parents > Settings)
KID_NAME=

# Your home time zone (IANA name), used for due times and reminders
TZ_HOME=Europe/London

# Your ntfy server (https://ntfy.sh or self-hosted). Leave NTFY_URL empty to switch
# notifications off (they are just logged). Must include https://
NTFY_URL=https://ntfy.example.com
NTFY_TOKEN=
KID_TOPIC=gsd-kid
PARENT_TOPIC=gsd-parents

# Tapping a notification opens this
APP_URL=https://gsd.example.com
